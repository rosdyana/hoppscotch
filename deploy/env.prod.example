# Production environment for docker-compose.prod.yml
#
#   cp deploy/env.prod.example .env
#
# Then do all three of these before the first `up`:
#   1. POSTGRES_PASSWORD    <- openssl rand -hex 24
#   2. DATA_ENCRYPTION_KEY  <- openssl rand -hex 16   (gives exactly 32 chars)
#   3. Replace every occurrence of hopp.example.com with your real domain
#
# .env is gitignored, so this file is safe to keep secrets in.

#-----------------------Compose Config-------------------------------#

# Makes plain `docker compose ...` target the production stack, so you never
# pass -f. Trade-off: the dev docker-compose.yml then needs an explicit
# `-f docker-compose.yml`.
#
# Pre-built image (recommended — see DEPLOY.md on why not to build locally):
COMPOSE_FILE=docker-compose.prod.yml:deploy/docker-compose.image.yml
#
# Source build instead:
# COMPOSE_FILE=docker-compose.prod.yml

# Which pre-built image to run. Defaults to this fork's GHCR image, published
# by .github/workflows/build-fork-image.yml on every version tag.
#   upstream stock : HOPP_IMAGE=hoppscotch/hoppscotch:latest
#   pinned release : HOPP_IMAGE=ghcr.io/rosdyana/hoppscotch:1.0.0
# HOPP_IMAGE=ghcr.io/rosdyana/hoppscotch:latest

#-----------------------Postgres-------------------------------------#
# Read by docker-compose.prod.yml, which builds DATABASE_URL from them.
# Do NOT set DATABASE_URL here — compose overrides it.

POSTGRES_USER=hoppscotch
POSTGRES_DB=hoppscotch

# openssl rand -hex 24
# Hex keeps it URL-safe inside DATABASE_URL. If you use your own password with
# special characters, they must be percent-encoded.
POSTGRES_PASSWORD=CHANGE_ME

#-----------------------Backend Config-------------------------------#

# Sensitive Data Encryption Key while storing in Database.
# MUST be exactly 32 CHARACTERS. Generate with: openssl rand -hex 16
#
# It is used as raw utf8 bytes for aes-256-cbc, so length is counted in
# characters, not bytes of entropy. `openssl rand -hex 32` (64 chars) and
# `openssl rand -base64 32` (44 chars) both fail at boot with
# ERR_CRYPTO_INVALID_KEYLEN. Do not wrap the value in quotes. Check with:
#   printf '%s' "$(grep '^DATA_ENCRYPTION_KEY=' .env | cut -d= -f2-)" | wc -c
#
# WARNING: this key encrypts the auto-generated JWT_SECRET and SESSION_SECRET
# stored in the database. Once the instance has booted once, changing it is
# unrecoverable — every subsequent boot fails with
# '"DATA_ENCRYPTION_KEY" value changed in .env file'. Set it now, back it up,
# never rotate it in place.
DATA_ENCRYPTION_KEY=CHANGE_ME_32_CHARS_EXACTLY______

# Whitelisted origins for the Hoppscotch App.
# This list controls which origins can interact with the app through cross-origin comms.
# Must contain your public origin, or CORS and auth cookies break.
# - app://localhost_3200 / app://hoppscotch: desktop app bundle origins
WHITELISTED_ORIGINS=https://hopp.example.com,app://localhost_3200,app://hoppscotch

# Optional: Default proxy URL offered to clients when proxying is enabled.
# Clients control whether requests are proxied via the in-app toggle; this only
# sets which URL they default to. Remove the variable to configure it solely
# from the admin dashboard.
PROXY_APP_URL="https://proxy.hoppscotch.io"

# Caddy sits in front of this, so read the client IP from X-Forwarded-For.
TRUST_PROXY=true

#-----------------------Frontend Config------------------------------#
# These are injected into the built SPAs when the container starts, not at
# build time. Changing the domain means editing this file and restarting the
# container — no rebuild.

# Serve app, admin and API from one domain under one TLS cert:
#   https://hopp.example.com/          app
#   https://hopp.example.com/admin     admin dashboard
#   https://hopp.example.com/backend   API
# (also set in docker-compose.prod.yml; kept here so it's visible)
ENABLE_SUBPATH_BASED_ACCESS=true

# Base URLs
# https:// here is what makes the backend issue Secure cookies. Getting this
# wrong is the usual reason login silently fails behind TLS.
VITE_BASE_URL=https://hopp.example.com
VITE_SHORTCODE_BASE_URL=https://hopp.example.com
VITE_ADMIN_URL=https://hopp.example.com/admin

# Backend URLs
VITE_BACKEND_GQL_URL=https://hopp.example.com/backend/graphql
VITE_BACKEND_WS_URL=wss://hopp.example.com/backend/graphql
VITE_BACKEND_API_URL=https://hopp.example.com/backend/v1

# Terms Of Service And Privacy Policy Links (Optional)
VITE_APP_TOS_LINK=https://docs.hoppscotch.io/support/terms
VITE_APP_PRIVACY_POLICY_LINK=https://docs.hoppscotch.io/support/privacy

# Set default to null as https://proxy.hoppscotch.io/ doesn't require an access token
VITE_PROXYSCOTCH_ACCESS_TOKEN=

#-----------------------Container Runtime Config---------------------#

# Caddy's in-container HTTP port. Leave unset: the container runs as root and
# binds :80 internally, which docker-compose.prod.yml maps to 127.0.0.1:3080.
# Only needed for non-root runtimes like OpenShift, where ports < 1024 are
# unavailable. Avoid internal ports 8080, 3200, 3000, 3100, 3170.
# HOPP_ALTERNATE_PORT=8000

#-----------------------Not configured here--------------------------#
# SMTP, OAuth providers (Google/GitHub/Microsoft), JWT/session secrets, token
# lifetimes and rate limits are NOT environment variables. They live in the
# Postgres infra_config table and are set through the admin dashboard
# onboarding flow at https://hopp.example.com/admin on first boot.
